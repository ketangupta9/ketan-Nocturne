<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title>MITTORA – The Earth Kitchen</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Cormorant+Garamond:ital,wght@0,500;0,700;1,500&family=Figtree:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{--soot:#140b07;--soot2:#1d110b;--clay:#b9552c;--flame:#f5a623;--flour:#f1e3c8;--leaf:#6f8f33;color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*,*::before,*::after{box-sizing:inherit}html{scroll-behavior:smooth;scroll-padding-top:5rem}
body{margin:0;background:var(--soot);color:var(--flour);font:400 1rem/1.7 Figtree,system-ui,sans-serif;overflow-x:hidden}
h1,h2,h3{font-family:Cinzel,serif;margin:0;line-height:1.15;letter-spacing:.04em}
.serif{font-family:'Cormorant Garamond',serif}img{max-width:100%;display:block}a{color:inherit}
:focus-visible{outline:2px solid var(--flame);outline-offset:3px}
.wrap{max-width:1120px;margin:0 auto;padding:0 1.25rem}
header{position:fixed;inset:0 0 auto;z-index:20;background:rgba(20,11,7,.88);backdrop-filter:blur(10px);border-bottom:1px solid #b9552c55;padding-top:env(safe-area-inset-top,0px)}
header .wrap{display:flex;align-items:center;justify-content:space-between;height:4rem}
.brand{font:700 1.25rem Cinzel,serif;letter-spacing:.2em;text-decoration:none;display:flex;gap:.7rem;align-items:center}
.brand img{width:38px;height:38px;border-radius:50%;object-fit:cover;object-position:50% 38%}
nav{display:flex;gap:1.5rem;font-size:.9rem}nav a{text-decoration:none;opacity:.8}nav a:hover{opacity:1;color:var(--flame)}
.btn{display:inline-block;padding:.8rem 1.6rem;border-radius:999px;background:linear-gradient(90deg,var(--clay),var(--flame));color:#1a0d06;font-weight:600;border:0;cursor:pointer;text-decoration:none;font-size:1rem}
.btn.ghost{background:none;border:1px solid #f1e3c855;color:var(--flour)}
@media(max-width:820px){nav{display:none}}
.hero{position:relative;min-height:100svh;display:grid;align-items:center;padding:6rem 0 3rem;overflow:hidden;background:radial-gradient(ellipse at 70% 55%,#5a2410 0,transparent 60%),var(--soot)}
.hero .wrap{display:grid;grid-template-columns:1.05fr 1fr;gap:2rem;align-items:center}
.hero h1{font-size:clamp(3rem,9vw,6.5rem);letter-spacing:.08em;color:var(--flour)}
.hero .sub{font:600 .95rem Figtree;letter-spacing:.35em;color:var(--flame);margin:.6rem 0 1.4rem}
.hero p.tag{font:italic 500 clamp(1.5rem,3.4vw,2.2rem)/1.3 'Cormorant Garamond',serif;color:var(--flame);margin:0 0 1rem}
.hero p.lead{max-width:34rem;opacity:.85}.cta{display:flex;gap:.8rem;flex-wrap:wrap;margin-top:1.8rem}
.emblem{position:relative;justify-self:center;width:min(100%,480px)}
.emblem img{border-radius:50% 50% 1.5rem 1.5rem;box-shadow:0 0 120px -10px #f5731d88;animation:glow 3.5s ease-in-out infinite alternate}
@keyframes glow{to{box-shadow:0 0 150px 0 #f5a623aa}}
.smoke{position:absolute;left:44%;top:-6%;width:70px;height:90px;filter:blur(14px);background:radial-gradient(#f1e3c855,transparent 70%);animation:rise 5s ease-out infinite}
@keyframes rise{from{transform:translateY(40px) scale(.6);opacity:.9}to{transform:translateY(-70px) scale(1.6);opacity:0}}
@media(prefers-reduced-motion:reduce){.emblem img,.smoke{animation:none}html{scroll-behavior:auto}}
@media(max-width:820px){.hero .wrap{grid-template-columns:1fr;text-align:center}.hero p.lead{margin:auto}.cta{justify-content:center}.emblem{order:-1;width:min(78%,340px)}}
.band{height:34px;background:url(data:image/jpeg;base64,) repeat-x center/auto 34px;border-block:1px solid #b9552c66}
section{padding:5.5rem 0}h2{font-size:clamp(1.8rem,4vw,2.9rem);margin-bottom:1rem}
.kicker{color:var(--flame);font:italic 500 1.3rem 'Cormorant Garamond',serif;margin-bottom:.4rem}
.story{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:center}
.story p{opacity:.88;max-width:34rem}
.photos{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}
.photos img{border-radius:1.2rem;width:100%;height:100%;object-fit:cover;border:1px solid #b9552c66}
.photos img:first-child{grid-row:span 2;aspect-ratio:3/4}.photos img:not(:first-child){aspect-ratio:1}
@media(max-width:820px){.story{grid-template-columns:1fr}}
.els{background:var(--soot2)}.grid4{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:1.2rem;margin-top:2.2rem}
.el{padding:1.8rem;border-left:3px solid var(--c);background:linear-gradient(180deg,#ffffff08,transparent)}
.el h3{font-size:1.5rem;color:var(--c);margin-bottom:.5rem}.el p{margin:0;opacity:.85;font-size:.95rem}
.menu-top{display:flex;justify-content:space-between;align-items:end;flex-wrap:wrap;gap:1rem}
.pills{display:flex;gap:.5rem;flex-wrap:wrap}.pills button{padding:.5rem 1.1rem;border-radius:999px;border:1px solid #f1e3c840;background:none;color:var(--flour);cursor:pointer;font:inherit;font-size:.9rem}
.pills button[aria-pressed=true]{background:var(--flame);color:#1a0d06;border-color:var(--flame)}
#grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.3rem;margin-top:2rem}
.dish{border:1px solid #b9552c55;border-radius:1.2rem;overflow:hidden;background:var(--soot2)}
.dish .ph{height:170px;background-image:url(data:image/jpeg;base64,);background-size:cover;position:relative}
.dish .ph::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,var(--soot2))}
.dish .b{padding:1.2rem 1.4rem 1.5rem}.dish h3{font-size:1.1rem;display:flex;justify-content:space-between;gap:1rem}.dish h3 span{color:var(--flame);white-space:nowrap}
.dish p{margin:.5rem 0 0;font-size:.92rem;opacity:.8}
.usp{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:2.2rem 3rem;margin-top:2.5rem}
.usp h3{font:700 1.25rem 'Cormorant Garamond',serif;letter-spacing:0;color:var(--flame);border-bottom:1px solid #b9552c66;padding-bottom:.5rem;margin-bottom:.6rem}.usp p{margin:0;opacity:.85}
.founder{background:var(--soot2)}.f{display:grid;grid-template-columns:320px 1fr;gap:3rem;align-items:center}
.fp{aspect-ratio:4/5;width:100%;object-fit:cover;object-position:50% 15%;border-radius:1.5rem;border:2px solid #f5a62388;display:grid;place-items:center;text-align:center;padding:1rem;font-size:.9rem;opacity:.9;background:#ffffff06}
.fp b{display:block;font:700 3rem Cinzel;color:var(--clay)}
@media(max-width:820px){.f{grid-template-columns:1fr}.fp{max-width:300px}}
form{display:grid;gap:.9rem;margin-top:1.5rem;max-width:30rem}label{font-size:.85rem;opacity:.8;display:grid;gap:.3rem}
input,select{padding:.8rem 1rem;border-radius:.7rem;border:1px solid #b9552c88;background:var(--soot);color:var(--flour);font:inherit}
.two{display:grid;grid-template-columns:1fr 1fr;gap:.9rem}
footer{padding:2.5rem 0;border-top:1px solid #b9552c55;text-align:center;font-size:.85rem;opacity:.75}
.contact a.big{font:700 1.5rem Cinzel;text-decoration:none;color:var(--flame)}
</style></head><body>
<header><div class="wrap"><a class="brand" href="#top"><img src="data:image/jpeg;base64," alt="">MITTORA</a>
<nav><a href="#story">Story</a><a href="#elements">Elements</a><a href="#menu">Menu</a><a href="#why">Experience</a><a href="#founder">Founder</a></nav>
<a class="btn" href="#reserve">Reserve a table</a></div></header>
<main id="top">
<div class="hero"><div class="wrap"><div>
<h1>MITTORA</h1><div class="sub">THE EARTH KITCHEN</div>
<p class="tag">Where Tradition Meets Taste.</p>
<p class="lead">Traditional Indian food, cooked over a clay chulah, served in earthen pots and enjoyed in a warm, modern room.</p>
<div class="cta"><a class="btn" href="#reserve">Book your table</a><a class="btn ghost" href="#menu">See the menu</a></div></div>
<div class="emblem"><img src="data:image/jpeg;base64," alt="MITTORA logo: a steaming clay handi over a chulah fire"><span class="smoke" aria-hidden="true"></span></div></div></div>
<div class="band" aria-hidden="true"></div>
<section id="story"><div class="wrap story"><div>
<p class="kicker">Some flavours are not created. They are inherited.</p><h2>Cooked slowly, the way it used to be</h2>
<p>Before modern kitchens, Indian cooking was simple: fresh ingredients from the earth, a clay chulah, an earthen pot and a table full of people you love.</p>
<p>MITTORA brings that back. Our name comes from <em>mitti</em> (मिट्टी), the soil. Everything we cook starts there.</p></div>
<div class="photos"><img src="data:image/jpeg;base64," alt="Clay handi with a traditional pattern band" loading="lazy"><img src="data:image/jpeg;base64," alt="Wood fire burning inside the chulah" loading="lazy"><img src="data:image/jpeg;base64," alt="Fresh green leaves beside the chulah" loading="lazy"></div></div></section>
<section id="elements" class="els"><div class="wrap"><p class="kicker">The meaning behind the name</p><h2>Earth, Fire, Clay, Soul</h2>
<div class="grid4">
<div class="el" style="--c:#8fb04a"><h3>Earth</h3><p>Fresh seasonal produce and honest ingredients are where every dish begins.</p></div>
<div class="el" style="--c:#f5a623"><h3>Fire</h3><p>The clay chulah brings patience, smoke and the slow warmth of wood embers.</p></div>
<div class="el" style="--c:#d9693a"><h3>Clay</h3><p>Handcrafted handis and kulhads keep food warm and add a gentle earthy depth.</p></div>
<div class="el" style="--c:#f1e3c8"><h3>Soul</h3><p>Food that brings people together and makes you remember home.</p></div></div></div></section>
<section id="menu"><div class="wrap"><div class="menu-top"><div><p class="kicker">From chulah to table</p><h2>Signature earthen menu</h2></div>
<div class="pills" role="group" aria-label="Filter menu"><button aria-pressed="true" data-f="all">All</button><button aria-pressed="false" data-f="chulah">Chulah starters</button><button aria-pressed="false" data-f="handi">Earthen handis</button><button aria-pressed="false" data-f="sweet">Kulhad sweets</button></div></div>
<div id="grid"></div></div></section>
<section id="why" class="els"><div class="wrap"><p class="kicker">What makes us different</p><h2>The MITTORA experience</h2>
<div class="usp"><div><h3>Clay-chulah cooking</h3><p>Smoky aroma and gentle heat you cannot get from a gas flame.</p></div>
<div><h3>Served in earthen pots</h3><p>Terracotta handis and kulhads come straight to your table, still warm.</p></div>
<div><h3>Seasonal ingredients</h3><p>The menu changes with the harvest, with local produce and fresh herbs.</p></div>
<div><h3>Heirloom recipes</h3><p>Regional dishes and hand-ground spice blends, made without shortcuts.</p></div>
<div><h3>A modern, welcoming room</h3><p>Earthy textures and warm light that feel premium without being stiff.</p></div></div></div></section>
<section id="founder"><div class="wrap f"><img class="fp" src="data:image/jpeg;base64," alt="Ketan Gupta, founder of MITTORA">
<div><p class="kicker">Meet the founder</p><h2>Ketan Gupta</h2><p style="max-width:34rem;opacity:.88">MITTORA started with a simple idea: the food we grew up with deserves a proper stage. Come hungry, bring family, and stay for the second helping.</p></div></div></section>
<section id="reserve" class="els contact"><div class="wrap"><p class="kicker">Lunch 12:00–3:30 PM · Dinner 7:00–11:30 PM</p><h2>Reserve a table</h2>
<p style="max-width:34rem;opacity:.85">Fill this in and it opens WhatsApp with your request ready to send to Ketan.</p>
<form id="rf"><label>Name<input id="n" required autocomplete="name"></label>
<div class="two"><label>Guests<select id="g"><option>2</option><option selected>4</option><option>6</option><option>8+</option></select></label><label>Date<input id="d" type="date" required></label></div>
<label>Session<select id="s"><option>Lunch</option><option selected>Dinner</option></select></label>
<label>Occasion or dietary note<input id="o" placeholder="Birthday, Jain, no onion…"></label>
<button class="btn" type="submit">Send on WhatsApp</button></form>
<p style="margin-top:2rem"><a class="big" href="tel:+918006693153">+91 80066 93153</a><br><a href="mailto:ketanguptaji1@gmail.com">ketanguptaji1@gmail.com</a></p></div></section>
</main>
<footer><div class="band" aria-hidden="true" style="margin-bottom:1.5rem"></div><div class="wrap">© 2026 MITTORA – The Earth Kitchen · Born from earth, inspired by tradition.</div></footer>
<script>
const M=[["Chulah-roasted bhutta seekh","chulah","₹420","Sweet corn and pounded garden herbs, blistered over wood embers with mint-tamarind chutney."],
["Smoked dahi and khoya kebab","chulah","₹460","Hung-curd medallions smoked over chulah charcoal with roasted cumin and green cardamom."],
["MITTORA dum dal handi","handi","₹540","Whole black lentils simmered for hours in an unglazed handi, finished with white butter."],
["Mitti-ki-khushboo subz handi","handi","₹520","Seasonal vegetables slow-cooked under a dough seal with freshly ground spices."],
["Sarson saag with makki roti","handi","₹490","Winter greens churned on the chulah, served with hand-patted maize rotis."],
["Kulhad phirni with saffron","sweet","₹290","Stone-ground rice pudding set in a clay kulhad, topped with saffron and pistachio."]];
const G=document.getElementById('grid');
function r(f){G.innerHTML=M.filter(m=>f=='all'||m[1]==f).map((m,i)=>`<article class="dish"><div class="ph" style="background-position:${(i*37)%100}% ${30+(i*17)%50}%"></div><div class="b"><h3>${m[0]}<span>${m[2]}</span></h3><p>${m[3]}</p></div></article>`).join('')}
r('all');
document.querySelectorAll('.pills button').forEach(b=>b.onclick=()=>{document.querySelectorAll('.pills button').forEach(x=>x.setAttribute('aria-pressed',x==b));r(b.dataset.f)});
document.getElementById('rf').onsubmit=e=>{e.preventDefault();const v=id=>document.getElementById(id).value;
const t=`Hi Ketan, I’d like to reserve a table at MITTORA.\nName: ${v('n')}\nGuests: ${v('g')}\nDate: ${v('d')}\nSession: ${v('s')}\nNote: ${v('o')||'-'}`;
window.open('https://wa.me/918006693153?text='+encodeURIComponent(t),'_blank')};
</script></body></html>
